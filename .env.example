# PayShield Environment Secrets & Configuration Template
NODE_ENV=production-demo
PORT=5000

# Security Secrets (Never commit production keys to git repositories)
JWT_SECRET=payshield_super_secret_jwt_key_2026_production_grade
JWT_EXPIRES_IN=1h

# Database Configuration (Dual-Mode: Connects to MongoDB URI or defaults to automated memory store)
MONGODB_URI=mongodb://localhost:27017/payshield_db

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
